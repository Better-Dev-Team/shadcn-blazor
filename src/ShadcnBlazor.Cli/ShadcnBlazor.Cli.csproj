<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>shadcn-blazor</ToolCommandName>
    <PackageId>BetterDev.ShadcnBlazor.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>Better-Dev-Team</Authors>
    <Company>Better-Dev-Team</Company>
    <Description>CLI tool for scaffolding ShadcnBlazor components directly into Blazor projects.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Better-Dev-Team/shadcn-blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Better-Dev-Team/shadcn-blazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor;cli;shadcn;shadcn-ui;tailwind;tools;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShadcnBlazor\ShadcnBlazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="..\ShadcnBlazor\Components\**\*.razor" />
    <None Remove="..\ShadcnBlazor\Common\*.cs" />
    <None Remove="..\ShadcnBlazor\Services\*.cs" />
    <None Remove="..\ShadcnBlazor\wwwroot\shadcn-blazor.css" />
    <None Remove="..\ShadcnBlazor\wwwroot\shadcn-blazor.js" />
    <EmbeddedResource Include="..\ShadcnBlazor\Components\**\*.razor"
                      Link="Assets\Components\%(RecursiveDir)%(Filename)%(Extension)"
                      LogicalName="ShadcnBlazor.Cli.assets.Components.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\ShadcnBlazor\Common\*.cs"
                      Link="Assets\Common\%(Filename)%(Extension)"
                      LogicalName="ShadcnBlazor.Cli.assets.Common.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\ShadcnBlazor\Services\*.cs"
                      Link="Assets\Services\%(Filename)%(Extension)"
                      LogicalName="ShadcnBlazor.Cli.assets.Services.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\ShadcnBlazor\wwwroot\shadcn-blazor.css"
                      Link="Assets\wwwroot\shadcn-blazor.css"
                      LogicalName="ShadcnBlazor.Cli.assets.wwwroot.shadcn-blazor.css" />
    <EmbeddedResource Include="..\ShadcnBlazor\wwwroot\shadcn-blazor.js"
                      Link="Assets\wwwroot\shadcn-blazor.js"
                      LogicalName="ShadcnBlazor.Cli.assets.wwwroot.shadcn-blazor.js" />
  </ItemGroup>

</Project>
