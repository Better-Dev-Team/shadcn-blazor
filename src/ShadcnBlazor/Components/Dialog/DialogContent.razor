@namespace ShadcnBlazor
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Parent?.Open == true)
{
    <!-- Backdrop Overlay -->
    <div class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm transition-all duration-150 animate-fade-in"
         @onclick="HandleOverlayClickAsync"></div>

    <!-- Modal Content -->
    <div class="fixed left-[50%] top-[50%] z-50 grid w-full max-w-lg translate-x-[-50%] translate-y-[-50%] gap-4 border bg-background p-6 shadow-lg duration-200 rounded-lg sm:rounded-xl animate-in fade-in zoom-in-95 @Class"
         id="@ElementId"
         role="dialog"
         aria-modal="true"
         @attributes="AdditionalAttributes">

        @ChildContent

        @if (ShowClose)
        {
            <button type="button"
                    class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none p-1"
                    @onclick="CloseAsync">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
                <span class="sr-only">Close</span>
            </button>
        }
    </div>
}

@code {
    [CascadingParameter] public Dialog? Parent { get; set; }
    [Parameter] public bool ShowClose { get; set; } = true;
    [Parameter] public bool CloseOnOverlayClick { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string ElementId = $"dialog-{Guid.NewGuid():N}";
    private bool _scrollLocked = false;

    protected override async Task OnParametersSetAsync()
    {
        if (Parent?.Open == true && !_scrollLocked)
        {
            _scrollLocked = true;
            try { await JS.InvokeVoidAsync("shadcnBlazor.lockScroll"); } catch {}
        }
        else if (Parent?.Open == false && _scrollLocked)
        {
            _scrollLocked = false;
            try { await JS.InvokeVoidAsync("shadcnBlazor.unlockScroll"); } catch {}
        }
    }

    private async Task CloseAsync()
    {
        if (Parent != null)
        {
            await Parent.SetOpenAsync(false);
        }
    }

    private async Task HandleOverlayClickAsync()
    {
        if (CloseOnOverlayClick)
        {
            await CloseAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_scrollLocked)
        {
            try { await JS.InvokeVoidAsync("shadcnBlazor.unlockScroll"); } catch {}
        }
    }
}
