<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>shadcn-blazor</ToolCommandName>
    <PackageId>ShadcnBlazor.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>Antigravity &amp; Community</Authors>
    <Description>CLI tool for scaffolding ShadcnBlazor components directly into Blazor projects.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShadcnBlazor\ShadcnBlazor.csproj" />
  </ItemGroup>

</Project>
