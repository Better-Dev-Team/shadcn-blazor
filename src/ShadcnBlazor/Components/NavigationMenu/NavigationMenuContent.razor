@namespace ShadcnBlazor

@if (Parent != null && Item != null && Parent.IsOpen(Item.Value))
{
    <div id="@(Item.ContentId)"
         class="@Cn.Class("absolute left-0 top-full mt-1 w-full origin-top rounded-md border bg-popover p-4 text-popover-foreground shadow-lg md:w-auto animate-in fade-in-0 zoom-in-95", Class)"
         role="region"
         aria-labelledby="@(Item.TriggerId)"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] public NavigationMenu? Parent { get; set; }
    [CascadingParameter] public NavigationMenuItem? Item { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
