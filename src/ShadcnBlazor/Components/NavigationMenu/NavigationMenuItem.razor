@namespace ShadcnBlazor

<CascadingValue Value="this" IsFixed="true">
    <li class="@Cn.Class("relative", Class)" @attributes="AdditionalAttributes">
        @ChildContent
    </li>
</CascadingValue>

@code {
    [CascadingParameter] public NavigationMenu? Parent { get; set; }
    [Parameter] public string Value { get; set; } = $"navigation-menu-{Guid.NewGuid():N}";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    public readonly string TriggerId = $"navigation-menu-trig-{Guid.NewGuid():N}";
    public readonly string ContentId = $"navigation-menu-cnt-{Guid.NewGuid():N}";
}
