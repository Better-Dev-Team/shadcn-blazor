@page "/404"
@namespace ShadcnBlazor.Docs.Pages

<div class="flex flex-col items-center justify-center min-h-[50vh] text-center space-y-4">
    <div class="rounded-full bg-muted p-4">
        <svg class="h-8 w-8 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
        </svg>
    </div>
    <h1 class="text-3xl font-extrabold tracking-tight">404 - Page Not Found</h1>
    <p class="text-sm text-muted-foreground max-w-sm">The component or documentation page you are looking for does not exist or has moved.</p>
    <Button Href="">Return Home</Button>
</div>