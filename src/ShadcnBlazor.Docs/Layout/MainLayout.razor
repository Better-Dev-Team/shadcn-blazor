@namespace ShadcnBlazor.Docs.Layout
@inherits LayoutComponentBase

<ThemeProvider>
    <div class="relative flex min-h-screen flex-col bg-background text-foreground selection:bg-primary selection:text-primary-foreground">
        <!-- Top Navbar -->
        <Navbar />

        <!-- Main Body Grid -->
        <div class="container flex-1 items-start md:grid md:grid-cols-[220px_minmax(0,1fr)] md:gap-6 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-10 px-4 sm:px-8">
            <Sidebar />
            <main class="relative py-6 lg:gap-10 lg:py-8 xl:grid xl:grid-cols-[1fr_200px]">
                <div class="mx-auto w-full min-w-0 max-w-3xl">
                    @Body
                </div>

                <!-- Right Table of Contents / Quick Links -->
                <div class="hidden text-sm xl:block">
                    <div class="sticky top-20 -mt-10 h-[calc(100vh-3.5rem)] pt-4 overflow-y-auto">
                        <div class="space-y-2">
                            <p class="font-medium text-xs text-foreground uppercase tracking-wider">On This Page</p>
                            <ul class="space-y-2 text-xs text-muted-foreground">
                                <li><a href="#overview" class="hover:text-foreground">Overview</a></li>
                                <li><a href="#installation" class="hover:text-foreground">Installation</a></li>
                                <li><a href="#usage" class="hover:text-foreground">Usage</a></li>
                                <li><a href="#examples" class="hover:text-foreground">Examples &amp; Variants</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </main>
        </div>

        <!-- Footer -->
        <footer class="border-t border-border/40 py-6 md:px-8 md:py-0">
            <div class="container flex flex-col items-center justify-between gap-4 md:h-16 md:flex-row px-4 sm:px-8 text-sm text-muted-foreground">
                <p>
                    Built with <span class="text-foreground font-semibold">Blazor</span> &amp; <span class="text-foreground font-semibold">Tailwind CSS</span>. The source code is on <a href="https://github.com" target="_blank" class="underline underline-offset-4 font-medium text-foreground">GitHub</a>.
                </p>
            </div>
        </footer>

        <!-- Toast Container -->
        <Toaster Position="ToastPosition.BottomRight" />
    </div>
</ThemeProvider>
