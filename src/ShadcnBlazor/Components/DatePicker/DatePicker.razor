@namespace ShadcnBlazor

<div class="@ComputedClass" @attributes="AdditionalAttributes">
    <Popover Open="@_open" OpenChanged="HandleOpenChangedAsync">
        <PopoverTrigger Class="w-full">
            <Button Type="button"
                    Variant="ButtonVariant.Outline"
                    Disabled="@Disabled"
                    Class="@TriggerClass"
                    aria-haspopup="dialog"
                    aria-expanded="@(_open ? "true" : "false")">
                <span class="truncate">
                    @(Value.HasValue ? Value.Value.ToString("MMMM d, yyyy") : Placeholder)
                </span>
                <svg class="ml-auto h-4 w-4 shrink-0 opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                    <line x1="16" x2="16" y1="2" y2="6"></line>
                    <line x1="8" x2="8" y1="2" y2="6"></line>
                    <line x1="3" x2="21" y1="10" y2="10"></line>
                </svg>
            </Button>
        </PopoverTrigger>

        <PopoverContent Placement="PopoverPlacement.BottomStart" Class="w-auto p-0">
            <Calendar Value="@Value"
                      ValueChanged="HandleDateSelectedAsync"
                      MinDate="@MinDate"
                      MaxDate="@MaxDate"
                      InitialMonth="@(Value ?? DateTime.Today)" />
        </PopoverContent>
    </Popover>
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; } = "Pick a date";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public DateTime? MinDate { get; set; }
    [Parameter] public DateTime? MaxDate { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _open;

    protected override void OnParametersSet()
    {
        if (Disabled)
        {
            _open = false;
        }
    }

    private string ComputedClass => Cn.Class("relative w-full", Class);

    private string TriggerClass => Cn.Class(
        "w-full justify-start text-left font-normal",
        Value.HasValue ? null : "text-muted-foreground");

    private Task HandleOpenChangedAsync(bool open)
    {
        _open = Disabled ? false : open;
        return Task.CompletedTask;
    }

    private async Task HandleDateSelectedAsync(DateTime? value)
    {
        if (Disabled)
        {
            return;
        }

        _open = false;
        Value = value;
        await ValueChanged.InvokeAsync(Value);
    }
}
