@namespace ShadcnBlazor

@if (IsExpanded)
{
    <div class="@ComputedClass" @attributes="AdditionalAttributes">
        <div class="pb-4 pt-0">
            @ChildContent
        </div>
    </div>
}

@code {
    [CascadingParameter] public Accordion? Accordion { get; set; }
    [CascadingParameter] public AccordionItem? Item { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsExpanded => Accordion != null && Item != null && Accordion.IsExpanded(Item.Value);

    private string ComputedClass => Cn.Class(
        "overflow-hidden text-sm transition-all animate-in fade-in-50 duration-200",
        Class
    );
}
