@page "/docs/components/dialog"
@namespace ShadcnBlazor.Docs.Pages.Docs.Components
@inject IToastService ToastService

<div class="space-y-8">
    <div class="space-y-2">
        <h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight">Dialog</h1>
        <p class="text-lg text-muted-foreground">
            A window overlaid on either the primary window or another dialog window, rendering the content underneath inert.
        </p>
    </div>

    <Separator />

    <ComponentPreview Title="Example Dialog" CodeSnippet="@_code">
        <Dialog>
            <DialogTrigger>
                <Button Variant="ButtonVariant.Outline">Edit Profile</Button>
            </DialogTrigger>
            <DialogContent Class="sm:max-w-[425px]">
                <DialogHeader>
                    <DialogTitle>Edit profile</DialogTitle>
                    <DialogDescription>
                        Make changes to your profile here. Click save when you are done.
                    </DialogDescription>
                </DialogHeader>
                <div class="grid gap-4 py-4">
                    <div class="grid grid-cols-4 items-center gap-4">
                        <Label Class="text-right">Name</Label>
                        <div class="col-span-3">
                            <Input @bind-Value="_name" Placeholder="Pedro Duarte" />
                        </div>
                    </div>
                </div>
                <DialogFooter>
                    <DialogClose>
                        <Button OnClick="@(() => ToastService.Success("Profile saved!"))">Save changes</Button>
                    </DialogClose>
                </DialogFooter>
            </DialogContent>
        </Dialog>
    </ComponentPreview>
</div>

@code {
    private string _name = "Pedro Duarte";
    private string _code = @"<Dialog>
    <DialogTrigger>
        <Button Variant=""ButtonVariant.Outline"">Edit Profile</Button>
    </DialogTrigger>
    <DialogContent Class=""sm:max-w-[425px]"">
        <DialogHeader>
            <DialogTitle>Edit profile</DialogTitle>
            <DialogDescription>
                Make changes to your profile here. Click save when you are done.
            </DialogDescription>
        </DialogHeader>
        <div class=""grid gap-4 py-4"">
            <div class=""grid grid-cols-4 items-center gap-4"">
                <Label Class=""text-right"">Name</Label>
                <div class=""col-span-3"">
                    <Input Placeholder=""Pedro Duarte"" />
                </div>
            </div>
        </div>
        <DialogFooter>
            <DialogClose>
                <Button>Save changes</Button>
            </DialogClose>
        </DialogFooter>
    </DialogContent>
</Dialog>";
}
