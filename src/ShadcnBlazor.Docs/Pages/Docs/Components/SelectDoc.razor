@page "/docs/components/select"
@namespace ShadcnBlazor.Docs.Pages.Docs.Components

<div class="space-y-8">
    <div class="space-y-2">
        <h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight">Select</h1>
        <p class="text-lg text-muted-foreground">
            Displays a list of options for the user to pick from—triggered by a button.
        </p>
    </div>

    <Separator />

    <ComponentPreview Title="Example Select" CodeSnippet="@_code">
        <div class="w-[200px]">
            <Select @bind-Value="_fruit">
                <SelectTrigger>
                    <SelectValue Placeholder="Select a fruit" />
                </SelectTrigger>
                <SelectContent>
                    <SelectLabel>Fruits</SelectLabel>
                    <SelectItem Value="apple" Label="Apple" />
                    <SelectItem Value="banana" Label="Banana" />
                    <SelectItem Value="blueberry" Label="Blueberry" />
                    <SelectItem Value="grapes" Label="Grapes" />
                    <SelectItem Value="pineapple" Label="Pineapple" />
                </SelectContent>
            </Select>
        </div>
    </ComponentPreview>
</div>

@code {
    private string? _fruit;
    private string _code = @"<Select @bind-Value=""_fruit"" Class=""w-[180px]"">
    <SelectTrigger>
        <SelectValue Placeholder=""Select a fruit"" />
    </SelectTrigger>
    <SelectContent>
        <SelectLabel>Fruits</SelectLabel>
        <SelectItem Value=""apple"" Label=""Apple"" />
        <SelectItem Value=""banana"" Label=""Banana"" />
        <SelectItem Value=""blueberry"" Label=""Blueberry"" />
        <SelectItem Value=""grapes"" Label=""Grapes"" />
        <SelectItem Value=""pineapple"" Label=""Pineapple"" />
    </SelectContent>
</Select>";
}
