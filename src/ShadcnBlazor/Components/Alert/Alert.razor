@namespace ShadcnBlazor

<div role="alert" class="@ComputedClass" @attributes="AdditionalAttributes">
    @if (Icon != null)
    {
        <div class="mr-3 mt-0.5 shrink-0">
            @Icon
        </div>
    }
    <div class="flex-1">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public AlertVariant Variant { get; set; } = AlertVariant.Default;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass => Cn.Class(
        "relative w-full rounded-lg border p-4 flex items-start [&>svg~*]:pl-7 [&>svg+div]:translate-y-[-3px] [&>svg]:absolute [&>svg]:left-4 [&>svg]:top-4 [&>svg]:text-foreground",
        Variant switch
        {
            AlertVariant.Default => "bg-background text-foreground",
            AlertVariant.Destructive => "border-destructive/50 text-destructive dark:border-destructive [&>svg]:text-destructive",
            AlertVariant.Success => "border-emerald-500/50 text-emerald-600 dark:text-emerald-400 bg-emerald-500/5",
            AlertVariant.Info => "border-blue-500/50 text-blue-600 dark:text-blue-400 bg-blue-500/5",
            AlertVariant.Warning => "border-amber-500/50 text-amber-600 dark:text-amber-400 bg-amber-500/5",
            _ => "bg-background text-foreground"
        },
        Class
    );
}
