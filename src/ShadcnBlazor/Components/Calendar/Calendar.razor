@namespace ShadcnBlazor

<div id="@_calendarId"
     class="@ComputedClass"
     role="group"
     aria-labelledby="@_headingId"
     aria-disabled="@(Disabled ? "true" : null)"
     @attributes="AdditionalAttributes">
    <div class="flex items-center justify-between gap-2">
        <Button Type="button"
                Variant="ButtonVariant.Ghost"
                Size="ButtonSize.Icon"
                Disabled="@(Disabled || !CanNavigatePrevious)"
                OnClick="GoToPreviousMonthAsync"
                aria-label="Previous month"
                title="Previous month">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6"></path>
            </svg>
        </Button>

        <div id="@_headingId" class="text-sm font-semibold" aria-live="polite">
            @_displayMonth.ToString("MMMM yyyy")
        </div>

        <Button Type="button"
                Variant="ButtonVariant.Ghost"
                Size="ButtonSize.Icon"
                Disabled="@(Disabled || !CanNavigateNext)"
                OnClick="GoToNextMonthAsync"
                aria-label="Next month"
                title="Next month">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6"></path>
            </svg>
        </Button>
    </div>

    <div class="mt-3 grid grid-cols-7 gap-1" role="grid" aria-labelledby="@_headingId">
        <div class="contents" role="row">
            @foreach (var weekday in WeekdayNames)
            {
                <div class="flex h-9 items-center justify-center text-center text-[0.8rem] font-normal text-muted-foreground" role="columnheader" aria-label="@weekday">
                    @weekday.Substring(0, 3)
                </div>
            }
        </div>

        @foreach (var day in GetCalendarDays())
        {
            var isOutside = day.Month != _displayMonth.Month || day.Year != _displayMonth.Year;

            <div @key="day" class="flex h-9 items-center justify-center" role="gridcell" aria-selected="@(IsSelected(day) ? "true" : "false")">
                @if (!isOutside || ShowOutsideDays)
                {
                    <button type="button"
                            class="@GetDayClass(day)"
                            aria-label="@GetDayAriaLabel(day)"
                            aria-current="@(IsToday(day) ? "date" : null)"
                            aria-pressed="@(IsSelected(day) ? "true" : "false")"
                            aria-disabled="@(!IsSelectable(day) || Disabled ? "true" : null)"
                            disabled="@(!IsSelectable(day) || Disabled)"
                            @onclick="() => SelectDateAsync(day)">
                        @day.Day
                    </button>
                }
                else
                {
                    <span class="h-9 w-9" aria-hidden="true"></span>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public DateTime? MinDate { get; set; }
    [Parameter] public DateTime? MaxDate { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowOutsideDays { get; set; } = true;
    [Parameter] public DateTime? InitialMonth { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private static readonly string[] WeekdayNames =
    {
        "Sunday",
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
    };

    private readonly string _calendarId = $"calendar-{Guid.NewGuid():N}";
    private readonly string _headingId = $"calendar-heading-{Guid.NewGuid():N}";
    private DateTime _displayMonth;
    private DateTime? _lastInitialMonth;
    private bool _initialized;

    protected override void OnParametersSet()
    {
        if (!_initialized || HasMonthChanged(_lastInitialMonth, InitialMonth))
        {
            _displayMonth = ConstrainMonth(InitialMonth ?? Value ?? DateTime.Today);
            _lastInitialMonth = InitialMonth;
            _initialized = true;
        }
        else if (HasValidDateRange && !MonthHasSelectableDay(_displayMonth))
        {
            _displayMonth = ConstrainMonth(_displayMonth);
        }
    }

    private bool HasValidDateRange => !MinDate.HasValue || !MaxDate.HasValue || MinDate.Value.Date <= MaxDate.Value.Date;

    private bool CanNavigatePrevious => HasValidDateRange && MonthHasSelectableDay(_displayMonth.AddMonths(-1));

    private bool CanNavigateNext => HasValidDateRange && MonthHasSelectableDay(_displayMonth.AddMonths(1));

    private string ComputedClass => Cn.Class("w-full min-w-[280px] rounded-md bg-background p-3", Class);

    private static bool HasMonthChanged(DateTime? first, DateTime? second)
    {
        if (first.HasValue != second.HasValue)
        {
            return true;
        }

        return first.HasValue && (first.Value.Year != second!.Value.Year || first.Value.Month != second.Value.Month);
    }

    private static DateTime FirstDayOfMonth(DateTime date) => new(date.Year, date.Month, 1);

    private DateTime ConstrainMonth(DateTime candidate)
    {
        var month = FirstDayOfMonth(candidate);

        if (MinDate.HasValue && month < FirstDayOfMonth(MinDate.Value))
        {
            month = FirstDayOfMonth(MinDate.Value);
        }

        if (MaxDate.HasValue && month > FirstDayOfMonth(MaxDate.Value))
        {
            month = FirstDayOfMonth(MaxDate.Value);
        }

        return month;
    }

    private bool MonthHasSelectableDay(DateTime month)
    {
        if (!HasValidDateRange)
        {
            return false;
        }

        var firstDay = FirstDayOfMonth(month).Date;
        var lastDay = firstDay.AddMonths(1).AddDays(-1).Date;

        return (!MinDate.HasValue || lastDay >= MinDate.Value.Date)
            && (!MaxDate.HasValue || firstDay <= MaxDate.Value.Date);
    }

    private IEnumerable<DateTime> GetCalendarDays()
    {
        var firstDay = FirstDayOfMonth(_displayMonth);
        var firstVisibleDay = firstDay.AddDays(-(int)firstDay.DayOfWeek);

        for (var index = 0; index < 42; index++)
        {
            yield return firstVisibleDay.AddDays(index);
        }
    }

    private async Task GoToPreviousMonthAsync()
    {
        if (!CanNavigatePrevious || Disabled)
        {
            return;
        }

        _displayMonth = _displayMonth.AddMonths(-1);
        await Task.CompletedTask;
    }

    private async Task GoToNextMonthAsync()
    {
        if (!CanNavigateNext || Disabled)
        {
            return;
        }

        _displayMonth = _displayMonth.AddMonths(1);
        await Task.CompletedTask;
    }

    private bool IsSelectable(DateTime date)
    {
        var day = date.Date;
        return HasValidDateRange
            && (!MinDate.HasValue || day >= MinDate.Value.Date)
            && (!MaxDate.HasValue || day <= MaxDate.Value.Date);
    }

    private bool IsSelected(DateTime date) => Value.HasValue && Value.Value.Date == date.Date;

    private static bool IsToday(DateTime date) => date.Date == DateTime.Today;

    private static string GetDayAriaLabel(DateTime date) => date.ToString("dddd, MMMM d, yyyy");

    private string GetDayClass(DateTime date)
    {
        var isOutside = date.Month != _displayMonth.Month || date.Year != _displayMonth.Year;

        return Cn.Class(
            "inline-flex h-9 w-9 items-center justify-center rounded-md p-0 text-sm font-normal transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50",
            isOutside ? "text-muted-foreground opacity-50" : null,
            IsToday(date) && !IsSelected(date) ? "border border-primary" : null,
            IsSelected(date) ? "bg-primary text-primary-foreground hover:bg-primary hover:text-primary-foreground" : null);
    }

    private async Task SelectDateAsync(DateTime date)
    {
        if (Disabled || !IsSelectable(date))
        {
            return;
        }

        Value = date.Date;
        _displayMonth = FirstDayOfMonth(date);
        await ValueChanged.InvokeAsync(Value);
    }
}
