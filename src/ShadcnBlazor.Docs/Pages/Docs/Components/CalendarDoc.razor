@page "/docs/components/calendar"
@namespace ShadcnBlazor.Docs.Pages.Docs.Components

<div class="space-y-8">
    <div class="space-y-2">
        <h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight">Calendar &amp; Date Picker</h1>
        <p class="text-lg text-muted-foreground">Select dates directly or through a compact popover input.</p>
    </div>

    <Separator />

    <ComponentPreview Title="Calendar" CodeSnippet="@_calendarCode">
        <div class="rounded-md border shadow-sm">
            <Calendar @bind-Value="_selectedDate" MinDate="@DateTime.Today.AddDays(-14)" MaxDate="@DateTime.Today.AddMonths(2)" />
        </div>
    </ComponentPreview>

    <ComponentPreview Title="Date picker" CodeSnippet="@_datePickerCode">
        <div class="w-full max-w-xs space-y-3">
            <DatePicker @bind-Value="_selectedDate" />
            <p class="text-sm text-muted-foreground text-center">
                Selected: @(_selectedDate?.ToString("MMMM d, yyyy") ?? "none")
            </p>
        </div>
    </ComponentPreview>
</div>

@code {
    private DateTime? _selectedDate = DateTime.Today;

    private string _calendarCode = @"<div class=""rounded-md border shadow-sm"">
    <Calendar @bind-Value=""_selectedDate"" />
</div>";

    private string _datePickerCode = @"<div class=""w-full max-w-xs space-y-3"">
    <DatePicker @bind-Value=""_selectedDate"" />
</div>";
}
