@namespace ShadcnBlazor

<button id="@(Parent?.TriggerId)"
        type="button"
        class="@Cn.Class("inline-flex items-center cursor-pointer", Class)"
        aria-expanded="@(IsOpen ? "true" : "false")"
        aria-controls="@(Parent?.ContentId)"
        disabled="@(Disabled || Parent?.Disabled == true)"
        @onclick="HandleClickAsync"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [CascadingParameter] public Collapsible? Parent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsOpen => Parent?.Open == true;

    private Task HandleClickAsync()
    {
        return Parent == null || Disabled ? Task.CompletedTask : Parent.ToggleAsync();
    }
}
