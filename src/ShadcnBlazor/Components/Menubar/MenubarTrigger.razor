@namespace ShadcnBlazor

<button id="@(Item?.TriggerId)"
        type="button"
        class="@ComputedClass"
        role="menuitem"
        aria-haspopup="menu"
        aria-expanded="@(IsOpen ? "true" : "false")"
        aria-controls="@(Item?.ContentId)"
        disabled="@(Disabled || Parent?.Disabled == true || Item?.Disabled == true)"
        @onclick="HandleClickAsync"
        @onmouseenter="HandleMouseEnterAsync"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [CascadingParameter] public Menubar? Parent { get; set; }
    [CascadingParameter] public MenubarMenu? Item { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsOpen => Parent != null && Item != null && Parent.IsOpen(Item.Value);

    private Task HandleClickAsync()
    {
        if (Parent == null || Item == null || Disabled || Parent.Disabled || Item.Disabled)
        {
            return Task.CompletedTask;
        }

        return Parent.ToggleMenuAsync(Item.Value);
    }

    private Task HandleMouseEnterAsync()
    {
        if (Parent == null || Item == null || Disabled || Parent.Disabled || Item.Disabled || IsOpen || !Parent.HasOpenMenu)
        {
            return Task.CompletedTask;
        }

        return Parent.SetValueAsync(Item.Value);
    }

    private string ComputedClass => Cn.Class(
        "inline-flex h-8 items-center rounded-sm px-3 text-sm font-medium outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground disabled:pointer-events-none disabled:opacity-50",
        IsOpen ? "bg-accent text-accent-foreground" : null,
        Class
    );
}
