@namespace ShadcnBlazor.Docs.Components
@implements IDisposable
@inject IThemeService ThemeService

<header class="sticky top-0 z-40 w-full border-b border-border/40 bg-background/95">
    <div class="container flex h-14 max-w-screen-2xl items-center justify-between px-4 sm:px-8">
        <!-- Logo and Main Navigation -->
        <div class="flex items-center gap-6 md:gap-8">
            <a href="" class="flex items-center space-x-2 font-bold tracking-tight text-foreground transition-opacity hover:opacity-90">
                <div class="flex h-6 w-6 items-center justify-center rounded-md bg-primary text-primary-foreground">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                </div>
                <span class="inline-block font-extrabold text-base">shadcn/blazor</span>
            </a>

            <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
                <a href="docs/introduction" class="transition-colors hover:text-foreground/80 text-foreground/60">Docs</a>
                <a href="docs/components/button" class="transition-colors hover:text-foreground/80 text-foreground/60">Components</a>
                <a href="docs/theming" class="transition-colors hover:text-foreground/80 text-foreground/60">Themes</a>
                <a href="docs/installation" class="transition-colors hover:text-foreground/80 text-foreground/60">CLI</a>
            </nav>
        </div>

        <!-- Right actions: Search, Theme, Customize, GitHub -->
        <div class="flex items-center gap-2">
            <!-- Theme Customizer -->
            <ThemeCustomizer />

            <!-- Light/Dark Mode Toggle -->
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-9 w-9" OnClick="ToggleThemeModeAsync">
                @if (ThemeService.IsDark)
                {
                    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
                    </svg>
                }
                else
                {
                    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                    </svg>
                }
                <span class="sr-only">Toggle theme</span>
            </Button>

            <!-- GitHub Link -->
            <a href="https://github.com" target="_blank" rel="noreferrer" class="inline-flex h-9 w-9 items-center justify-center rounded-md text-foreground/60 transition-colors hover:text-foreground hover:bg-accent">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span class="sr-only">GitHub</span>
            </a>
        </div>
    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        ThemeService.OnChange += OnThemeChanged;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= OnThemeChanged;
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private async Task ToggleThemeModeAsync()
    {
        var newMode = ThemeService.IsDark ? ThemeMode.Light : ThemeMode.Dark;
        await ThemeService.SetModeAsync(newMode);
    }
}
