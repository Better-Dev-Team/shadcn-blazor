@namespace ShadcnBlazor

<div class="@Cn.Class("relative flex w-full touch-none select-none items-center", Class)">
    <input type="range"
           min="@Min"
           max="@Max"
           step="@Step"
           value="@Value"
           disabled="@Disabled"
           style="@TrackGradientStyle"
           class="w-full h-2 rounded-full appearance-none cursor-pointer accent-primary focus:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"
           @oninput="HandleInput"
           @attributes="AdditionalAttributes" />
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public double Min { get; set; } = 0;
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private double Percentage => Max > Min ? Math.Clamp(((Value - Min) / (Max - Min)) * 100.0, 0.0, 100.0) : 0.0;

    private string TrackGradientStyle =>
        $"background: linear-gradient(to right, hsl(var(--primary)) 0%, hsl(var(--primary)) {Percentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%, hsl(var(--secondary)) {Percentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%, hsl(var(--secondary)) 100%);";

    private async Task HandleInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var val) ||
            double.TryParse(e.Value?.ToString(), out val))
        {
            Value = val;
            await ValueChanged.InvokeAsync(Value);
        }
    }
}
