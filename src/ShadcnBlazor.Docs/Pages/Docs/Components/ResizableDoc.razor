@page "/docs/components/resizable"
@namespace ShadcnBlazor.Docs.Pages.Docs.Components

<div class="space-y-8">
    <div class="space-y-2">
        <h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight">Resizable</h1>
        <p class="text-lg text-muted-foreground">
            Accessible resizable panel groups and layout splitters.
        </p>
    </div>

    <Separator />

    <!-- Horizontal Preview -->
    <ComponentPreview Title="Horizontal Split" CodeSnippet="@_horizontalCode">
        <div class="h-[200px] w-full max-w-md rounded-lg border overflow-hidden">
            <ResizablePanelGroup Direction="ResizableOrientation.Horizontal">
                <ResizablePanel DefaultSize="50">
                    <div class="flex h-full items-center justify-center p-6 bg-muted/20">
                        <span class="font-semibold text-sm">One</span>
                    </div>
                </ResizablePanel>
                <ResizableHandle WithHandle="true" />
                <ResizablePanel DefaultSize="50">
                    <div class="flex h-full items-center justify-center p-6 bg-muted/40">
                        <span class="font-semibold text-sm">Two</span>
                    </div>
                </ResizablePanel>
            </ResizablePanelGroup>
        </div>
    </ComponentPreview>

    <!-- Vertical Split Preview -->
    <ComponentPreview Title="Vertical Split" CodeSnippet="@_verticalCode">
        <div class="h-[250px] w-full max-w-md rounded-lg border overflow-hidden">
            <ResizablePanelGroup Direction="ResizableOrientation.Vertical">
                <ResizablePanel DefaultSize="40">
                    <div class="flex h-full items-center justify-center p-4 bg-muted/20">
                        <span class="font-semibold text-sm">Header</span>
                    </div>
                </ResizablePanel>
                <ResizableHandle WithHandle="true" />
                <ResizablePanel DefaultSize="60">
                    <div class="flex h-full items-center justify-center p-4 bg-muted/40">
                        <span class="font-semibold text-sm">Content</span>
                    </div>
                </ResizablePanel>
            </ResizablePanelGroup>
        </div>
    </ComponentPreview>
</div>

@code {
    private string _horizontalCode = @"<div class=""h-[200px] w-full max-w-md rounded-lg border"">
    <ResizablePanelGroup Direction=""ResizableOrientation.Horizontal"">
        <ResizablePanel DefaultSize=""50"">
            <div class=""flex h-full items-center justify-center p-6 bg-muted/20"">
                <span class=""font-semibold text-sm"">One</span>
            </div>
        </ResizablePanel>
        <ResizableHandle WithHandle=""true"" />
        <ResizablePanel DefaultSize=""50"">
            <div class=""flex h-full items-center justify-center p-6 bg-muted/40"">
                <span class=""font-semibold text-sm"">Two</span>
            </div>
        </ResizablePanel>
    </ResizablePanelGroup>
</div>";

    private string _verticalCode = @"<div class=""h-[250px] w-full max-w-md rounded-lg border"">
    <ResizablePanelGroup Direction=""ResizableOrientation.Vertical"">
        <ResizablePanel DefaultSize=""40"">
            <div class=""flex h-full items-center justify-center p-4 bg-muted/20"">
                <span class=""font-semibold text-sm"">Header</span>
            </div>
        </ResizablePanel>
        <ResizableHandle WithHandle=""true"" />
        <ResizablePanel DefaultSize=""60"">
            <div class=""flex h-full items-center justify-center p-4 bg-muted/40"">
                <span class=""font-semibold text-sm"">Content</span>
            </div>
        </ResizablePanel>
    </ResizablePanelGroup>
</div>";
}
