@namespace ShadcnBlazor
@implements IDisposable

@if (Parent?.IsItemVisible(this) ?? true)
{
    <button type="button"
            role="option"
            aria-selected="@(IsSelected ? "true" : "false")"
            disabled="@(Disabled || Parent?.Disabled == true)"
            class="@ComputedClass"
            @onclick="HandleSelectAsync"
            @attributes="AdditionalAttributes">
        <span class="flex-1 text-left">
            @if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                @(Label ?? Value)
            }
        </span>
        @if (IsSelected)
        {
            <svg class="ml-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        }
    </button>
}

@code {
    [CascadingParameter] public Combobox? Parent { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsSelected => Parent?.Value == Value;

    protected override void OnInitialized()
    {
        Parent?.RegisterItem(this);
    }

    public void Dispose()
    {
        Parent?.UnregisterItem(this);
    }

    private async Task HandleSelectAsync()
    {
        if (Disabled || Parent?.Disabled == true || Parent == null)
        {
            return;
        }

        await Parent.SelectValueAsync(Value, Label ?? Value);
    }

    private string ComputedClass => Cn.Class(
        "relative flex w-full cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground disabled:pointer-events-none disabled:opacity-50",
        Class
    );

    public bool IsVisible => Parent?.IsItemVisible(this) ?? true;
}
