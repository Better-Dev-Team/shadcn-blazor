@page "/docs/components/button"
@namespace ShadcnBlazor.Docs.Pages.Docs.Components

<div class="space-y-8">
    <div class="space-y-2">
        <h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight">Button</h1>
        <p class="text-lg text-muted-foreground">
            Displays a button or a component that looks like a button.
        </p>
    </div>

    <Separator />

    <!-- Default Preview -->
    <ComponentPreview Title="Default" CodeSnippet='<Button>Button</Button>'>
        <Button>Button</Button>
    </ComponentPreview>

    <!-- Variants Preview -->
    <ComponentPreview Title="Variants" CodeSnippet='<div class="flex flex-wrap gap-3">
    <Button Variant="ButtonVariant.Default">Default</Button>
    <Button Variant="ButtonVariant.Secondary">Secondary</Button>
    <Button Variant="ButtonVariant.Destructive">Destructive</Button>
    <Button Variant="ButtonVariant.Outline">Outline</Button>
    <Button Variant="ButtonVariant.Ghost">Ghost</Button>
    <Button Variant="ButtonVariant.Link">Link</Button>
</div>'>
        <div class="flex flex-wrap items-center justify-center gap-3">
            <Button Variant="ButtonVariant.Default">Default</Button>
            <Button Variant="ButtonVariant.Secondary">Secondary</Button>
            <Button Variant="ButtonVariant.Destructive">Destructive</Button>
            <Button Variant="ButtonVariant.Outline">Outline</Button>
            <Button Variant="ButtonVariant.Ghost">Ghost</Button>
            <Button Variant="ButtonVariant.Link">Link</Button>
        </div>
    </ComponentPreview>

    <!-- Sizes Preview -->
    <ComponentPreview Title="Sizes" CodeSnippet='<div class="flex items-center gap-3">
    <Button Size="ButtonSize.Sm">Small</Button>
    <Button Size="ButtonSize.Default">Default</Button>
    <Button Size="ButtonSize.Lg">Large</Button>
    <Button Size="ButtonSize.Icon">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m9 18 6-6-6-6"/></svg>
    </Button>
</div>'>
        <div class="flex items-center justify-center gap-3">
            <Button Size="ButtonSize.Sm">Small</Button>
            <Button Size="ButtonSize.Default">Default</Button>
            <Button Size="ButtonSize.Lg">Large</Button>
            <Button Size="ButtonSize.Icon">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            </Button>
        </div>
    </ComponentPreview>

    <!-- Loading State -->
    <ComponentPreview Title="Loading State" CodeSnippet='<Button Loading="true">Please wait</Button>'>
        <Button Loading="true">Please wait</Button>
    </ComponentPreview>
</div>
