@namespace ShadcnBlazor
@inject IToastService ToastService

<div class="@ComputedClass" role="status" aria-live="polite">
    <div class="flex items-start w-full gap-3">
        <!-- Icon -->
        <div class="shrink-0 mt-0.5">
            @if (Toast.CustomIcon != null)
            {
                @Toast.CustomIcon
            }
            else
            {
                @switch (Toast.Type)
                {
                    case ToastType.Success:
                        <svg class="h-5 w-5 text-emerald-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        break;
                    case ToastType.Error:
                        <svg class="h-5 w-5 text-destructive" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="15" y1="9" x2="9" y2="15"></line>
                            <line x1="9" y1="9" x2="15" y2="15"></line>
                        </svg>
                        break;
                    case ToastType.Warning:
                        <svg class="h-5 w-5 text-amber-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        break;
                    case ToastType.Info:
                        <svg class="h-5 w-5 text-blue-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        break;
                    case ToastType.Loading:
                        <svg class="h-5 w-5 animate-spin text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        break;
                }
            }
        </div>

        <!-- Content -->
        <div class="flex-1 min-w-0">
            <div class="text-sm font-semibold leading-tight text-foreground">
                @Toast.Title
            </div>
            @if (!string.IsNullOrEmpty(Toast.Description))
            {
                <div class="mt-1 text-xs text-muted-foreground leading-normal">
                    @Toast.Description
                </div>
            }
            @if (!string.IsNullOrEmpty(Toast.ActionText) && Toast.OnAction != null)
            {
                <button type="button"
                        class="mt-2 text-xs font-medium text-primary hover:underline"
                        @onclick="HandleActionAsync">
                    @Toast.ActionText
                </button>
            }
        </div>

        <!-- Close button -->
        <button type="button"
                class="shrink-0 rounded-sm opacity-60 transition-opacity hover:opacity-100 focus:outline-none focus:ring-1 focus:ring-ring p-0.5"
                @onclick="Dismiss">
            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ToastModel Toast { get; set; } = default!;

    private void Dismiss()
    {
        ToastService.Dismiss(Toast.Id);
    }

    private async Task HandleActionAsync()
    {
        if (Toast.OnAction != null)
        {
            await Toast.OnAction();
            Dismiss();
        }
    }

    private string ComputedClass => Cn.Class(
        "pointer-events-auto relative flex w-full max-w-sm items-center justify-between space-x-2 overflow-hidden rounded-lg border bg-background p-4 shadow-lg transition-all animate-in fade-in slide-in-from-bottom-5 duration-200"
    );
}
