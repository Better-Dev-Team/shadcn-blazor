@page "/docs/components/slider"
@namespace ShadcnBlazor.Docs.Pages.Docs.Components

<div class="space-y-8">
    <div class="space-y-2">
        <h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight">Slider</h1>
        <p class="text-lg text-muted-foreground">
            An input where the user selects a value from within a given range.
        </p>
    </div>

    <Separator />

    <!-- Default Preview -->
    <ComponentPreview Title="Default Slider" CodeSnippet="@_code">
        <div class="w-64 space-y-4 mx-auto p-4">
            <Slider @bind-Value="_sliderValue" Min="0" Max="100" Step="1" />
            <div class="text-sm text-muted-foreground text-center">Value: @_sliderValue</div>
        </div>
    </ComponentPreview>
</div>

@code {
    private double _sliderValue = 33;

    private string _code = @"<Slider @bind-Value=""_sliderValue"" Min=""0"" Max=""100"" Step=""1"" />
<div class=""text-sm text-muted-foreground"">Value: @_sliderValue</div>";
}
